{
  "name": "@hostpanel/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Root agent: the only HostPanel process allowed to change the server. Consumes typed jobs from Redis.",
  "scripts": {
    "dev": "AGENT_DRY_RUN=true tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hostpanel/shared": "0.1.0",
    "bullmq": "5.81.5",
    "dotenv": "16.4.7",
    "ioredis": "5.11.1",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
