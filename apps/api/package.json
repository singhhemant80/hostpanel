{
  "name": "@hostpanel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:seed": "node dist/seed.js",
    "test": "tsx --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/static": "8.1.0",
    "@hostpanel/shared": "0.1.0",
    "@node-rs/argon2": "2.0.2",
    "bcryptjs": "2.4.3",
    "bullmq": "5.81.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.2.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.2",
    "otplib": "12.0.1",
    "pg": "8.13.1",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.13",
    "drizzle-kit": "0.31.11",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
