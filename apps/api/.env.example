# ---- HostPanel API ----
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4100
# Public URL of the panel (used for cookies, CORS and GitHub webhook URL shown in the UI)
PANEL_URL=https://panel.example.com
# Hostname Caddy should serve the panel on (no scheme). Leave empty to skip.
PANEL_HOSTNAME=panel.example.com
ACME_EMAIL=admin@example.com

DATABASE_URL=postgresql://hostpanel:CHANGE_ME@127.0.0.1:5432/hostpanel
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# 32-byte hex keys: `openssl rand -hex 32`
JWT_SECRET=
APP_ENCRYPTION_KEY=

# Public IPv4/IPv6 of this server, shown to users as DNS targets
SERVER_IPV4=
SERVER_IPV6=

# ---- GitHub App (Settings → Developer settings → GitHub Apps) ----
# Permissions: Contents (read), Commit statuses (read & write), Metadata (read). Events: Push.
# Webhook URL: https://panel.example.com/api/v1/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Path to the App's private key (.pem), readable by the hostpanel user
GITHUB_APP_PRIVATE_KEY_PATH=/etc/hostpanel/github-app.pem

# Serve the built React UI from the API process (apps/web/dist)
WEB_DIST=../web/dist

# Shared-secret API key for CRAPPLET billing to create/suspend hosting accounts.
# Send as `Authorization: Bearer <key>` to /api/v1/provisioning/*
PROVISIONING_API_KEY=
